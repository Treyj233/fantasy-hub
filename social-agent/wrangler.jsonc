{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fantasy-hub-social-agent",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "POSTING_MODE": "live",
    "POLL_INTERVAL_SECONDS": "300",
    "MIN_POST_INTERVAL_MINUTES": "12",
    "MAX_POSTS_PER_DAY": "20",
    "GAMEDAY_MAX_POSTS_PER_DAY": "100",
    "X_SOURCE_HANDLES": "RapSheet,AdamSchefter,TomPelissero,MikeGarafolo,UnderdogNFL,32BeatWriters"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "SOCIAL_AGENT", "class_name": "FantasyHubSocialAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FantasyHubSocialAgent"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
