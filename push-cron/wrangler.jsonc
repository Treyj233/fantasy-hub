{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fantasy-hub-push-cron",
  "main": "worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "TARGET_URL": "https://fantasy-hub.treyj233.chatgpt.site/api/notifications/run"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
